{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "ROS: central_catkin_make",
            "type": "shell",
            "command": "catkin_make",
            "args": [
                "--directory",
                "/home/umaps/Desktop/-K-AutoDrivingLocalization/src/positioning/keti_ws",
                "-j4",
                "-DCMAKE_BUILD_TYPE=Debug",
                "-DCMAKE_EXPORT_COMPILE_COMMANDS=1"
            ],
            "problemMatcher": "$catkin-gcc",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
			"label": "ROS: roslaunch",
			"type": "shell",
			"command": "/bin/bash",
			"args": ["-c", "source /opt/ros/noetic/setup.bash && source /home/umaps/Desktop/-K-AutoDrivingLocalization/src/positioning/keti_ws/devel/setup.bash && roslaunch ipe ipe.launch"],
			"problemMatcher": []
		}
    ]
}
