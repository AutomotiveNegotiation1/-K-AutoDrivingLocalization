{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "ROS: central_catkin_make",
            "type": "shell",
            "command": "catkin_make",
            "args": [
                "--directory",
                "${workspaceFolder}",
                "-j4",
                "-DCMAKE_BUILD_TYPE=Debug",
                "-DCMAKE_EXPORT_COMPILE_COMMANDS=1"
            ],
            "problemMatcher": "$catkin-gcc",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "ROS: roslaunch",
            "type": "shell",
            "command": "bash -c 'source /opt/ros/melodic/setup.bash && source ${workspaceFolder}/devel/setup.bash && roslaunch ipe ipe.launch'",
            "problemMatcher": []
        }
    ]
}
