{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "ROS: central_catkin_make",
            "type": "catkin_make",
            "args": [
                "--directory",
                "${workspaceFolder}",
                "-j4",
                "-DCMAKE_BUILD_TYPE=Debug",
                "-DCMAKE_EXPORT_COMPILE_COMMANDS=1"
            ],
            "problemMatcher": "$catkin-gcc",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "source ROS setup.bash",
            "type": "shell",
            "command": "source",
            "args": ["devel/setup.bash"],
            "problemMatcher": []
        },        
        {
            "label": "ROS: roslaunch",
            "type": "shell",
            "command": "roslaunch",
            "args": ["${workspaceFolder}/src/run/launch/run.launch"],
            "problemMatcher": []
        }
    ]
}
