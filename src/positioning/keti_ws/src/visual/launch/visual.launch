<launch>
    <!-- Use groups if you want to launch several nodes for multiple devices.
    Make sure to use different param files for each sensor. -->
    <!-- <group ns="sensor_1"> -->
        <node  name="visual_node" pkg="visual" type="visual_node" output="screen">
            <rosparam command="load" file="$(find visual)/param/keti_pos_node.yaml" />
        </node>
    <!-- </group> -->
</launch>