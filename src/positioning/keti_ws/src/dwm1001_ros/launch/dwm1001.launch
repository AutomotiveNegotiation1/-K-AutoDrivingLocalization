<launch>

    <!--Exctract info from dwm1001 dev boards, filter them and publish them into topics-->
    <node pkg="localizer_dwm1001" type="dwm1001_main.py" name="localizer_dwm1001_01" output="screen">

        <param name="serial_port_name"      value="/dev/ttyACM0" /> <!-- Name of serial port -->
        <param name="device_id"      value="tag1" /> <!-- Name of serial id -->
        <param name="serial_baud_rate"      value="115200" />  <!--Baudrate of serial port-->

    </node>
    
    <node pkg="localizer_dwm1001" type="dwm1001_main.py" name="localizer_dwm1001_02" output="screen">

        <param name="serial_port_name"      value="/dev/ttyACM1" /> <!-- Name of serial port -->
        <param name="device_id"      value="tag2" /> <!-- Name of serial id -->
        <param name="serial_baud_rate"      value="115200" />  <!--Baudrate of serial port-->

    </node>
    
    <node pkg="localizer_dwm1001" type="dwm1001_main.py" name="localizer_dwm1001_03" output="screen">

        <param name="serial_port_name"      value="/dev/ttyACM2" /> <!-- Name of serial port -->
        <param name="device_id"      value="tag3" /> <!-- Name of serial id -->
        <param name="serial_baud_rate"      value="115200" />  <!--Baudrate of serial port-->

    </node>
    
    <node pkg="localizer_dwm1001" type="dwm1001_main.py" name="localizer_dwm1001_04" output="screen">

        <param name="serial_port_name"      value="/dev/ttyACM3" /> <!-- Name of serial port -->
        <param name="device_id"      value="tag4" /> <!-- Name of serial id -->
        <param name="serial_baud_rate"      value="115200" />  <!--Baudrate of serial port-->

    </node>
    

    <!-- Display topics of anchors and tag into markers so we can view them into Rviz-->
    <!-- <node pkg="localizer_dwm1001" type="dwm1001_displayMap.py" name="display_dwm1001" /> -->
    <!-- Run rviz with the saved rviz file-->
    <!-- <node type="rviz" name="rviz" pkg="rviz" args="-d $(find localizer_dwm1001)/rviz/dwm1001_network.rviz" /> -->


</launch>
