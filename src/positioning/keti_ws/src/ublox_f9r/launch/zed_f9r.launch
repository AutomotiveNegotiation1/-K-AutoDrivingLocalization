<launch>
  <arg name="debug_output" default="log"/>
  <!-- Node for IMU -->
  <node name="zed_f9r" pkg="localizer_zed_f9r" type="zed_f9r_main.py" output="$(arg debug_output)">
    <param name="port" value="ttyIMU"/>
    <param name="baud_rate" value="230400"/>
    <param name="frame_id" value="IMU"/>
  </node>
</launch>
