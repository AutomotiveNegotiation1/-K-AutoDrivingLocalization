function [Nav] = ins_position_back(Nav, IMU, gyro_bias)

persistent init_first
persistent firstRun
persistent vx_e vy_e vz_e
persistent ax_e ay_e az_e
persistent pos flip
persistent k acc_e v_e att_hor
persistent acc_vec

if isempty(firstRun)
    init_first = 0;
    flip = 0;
    firstRun = 1;
    vx_e = 0; vy_e = 0; vz_e = 0;
    ax_e = 0; ay_e = 0; az_e = 0;
    pos = [0 0 0]';
    v_e = [0 0 0]';
    k = 1;
    acc_e= [0 0 0]';
    att_hor = [1 0 0 0]';
    acc_vec = [0 0 0]';
end
alpha = (k-1) / k;


if ((IMU.acc(3) > 9)&(init_first==0)) || (flip==1)
    p = IMU.gyro(1)-gyro_bias(1);
    q = -(IMU.gyro(2)-gyro_bias(2));
    r = -(IMU.gyro(3)-gyro_bias(3));
    ax = IMU.acc(1);
    ay = -IMU.acc(2);
    az = -IMU.acc(3);
    flip = 1;
else
    
    p = IMU.gyro(1)-gyro_bias(1);
    q = IMU.gyro(2)-gyro_bias(2);
    r = IMU.gyro(3)-gyro_bias(3);
    ax = IMU.acc(1);
    ay = IMU.acc(2);
    az = IMU.acc(3);
    A = eye(4)+dt*1/2*[0 -p -q -r;
    p 0 r -q;
    q -r 0 p;
    r q -p 0
    ];
end

if (IMU.SimulationTime >= Nav.imu_align.time)&(init_first==0)    % [sec]
%     Nav.gravity = norm(Nav.imu_align.g_body);
    %         Nav.mode = mode;
    init_first = 1;
elseif (IMU.SimulationTime < Nav.imu_align.time)

    Nav.imu_bias.gyro = alpha*Nav.imu_bias.gyro + (1-alpha)*[p q r]';
    Nav.imu_align.g_body = alpha*Nav.imu_align.g_body + (1-alpha)*[ax ay az]';
    Nav.gravity = norm(Nav.imu_align.g_body);
    [phi, theta] = EulerAcc(Nav.imu_align.g_body(1), Nav.imu_align.g_body(2), Nav.imu_align.g_body(3));
else
    [phi, theta] = EulerAcc(ax, ay, az);
end


dt = IMU.dt;
% dt = 0.01;
A = eye(4)+dt*1/2*[0 -p -q -r;
    p 0 r -q;
    q -r 0 p;
    r q -p 0
    ];
    
% psi = 0;

z = EulerToQuaternion(phi, theta, 0);

[phi, theta, psi] = EulerKalman(A, z);

att_hor = EulerToQuaternion(phi, theta, psi);


    
if init_first == 1
%     att_hor = EulerToQuaternion(phi, theta, psi);
%     Nav.output.att = Qua_Update(Nav.output.att,att_hor);
%     Nav.output.att = A*Nav.output.att;
    Nav.output.att = Qua_Update([1 0 0 0]',att_hor);
    Nav.output.C_b2n = qua2dcm(Nav.output.att);
    Nav.output.C_n2b = Nav.output.C_b2n';

    
%     v_b = Nav.output.C_b2n*[vx_e vy_e vz_e]';
    v_b = Nav.output.C_n2b*[vx_e vy_e vz_e]';
%     v_b = Nav.output.C_n2b*[vx_e vy_e 0]';
%     v_b = [vx_e vy_e vz_e]';
    vx_b = v_b(1);vy_b=v_b(2);vz_b=v_b(3);
    a_e = Nav.output.C_b2n*[ax ay az]';
    ax_e = a_e(1);ay_e = a_e(2);az_e = a_e(3);
    acc_e = (-acc_vec)+([ax ay az]'-[0 vz_b -vy_b; -vz_b 0 vx_b;vy_b -vx_b 0]*[p;q;r]-Nav.gravity*[sin(theta);-cos(theta)*sin(phi);-cos(theta)*cos(phi)]);
%     acc_e = ([ax_e ay_e az_e]'-[0 vz_e -vy_e; -vz_e 0 vx_e;vy_e -vx_e 0]*[p;q;r]-Nav.gravity*[sin(theta);-cos(theta)*sin(phi);-cos(theta)*cos(phi)]);
%     acc_e = Nav.output.C_n2b*acc_b;
%     acc_e = Nav.output.C_b2n*acc_b;
%     acc_e = acc_b;
%     acc_e(3) = 0;
    v_e = [vx_e;vy_e;vz_e]+acc_e*dt;
    pos = pos + [vx_e;vy_e;vz_e]*dt + 1/2*dt^2*acc_e;
%     ax_e = acc_e(1);ay_e = acc_e(2);az_e = acc_e(3);
    vx_e = v_e(1);vy_e = v_e(2);vz_e = v_e(3);
else
    acc_e = ([Nav.imu_align.g_body(1) Nav.imu_align.g_body(2) Nav.imu_align.g_body(3)]'-Nav.gravity*[sin(theta);-cos(theta)*sin(phi);-cos(theta)*cos(phi)]);
%     acc_vec=acc_vec.*alpha+acc_e.*(1-alpha);
    acc_vec = acc_e;
    Nav.output.att = Qua_Update([1 0 0 0],att_hor);
    Nav.output.C_b2n = qua2dcm(Nav.output.att);
    Nav.output.C_n2b = Nav.output.C_b2n';

end
    Nav.output.acc = acc_e;
    Nav.output.pos = pos;
    Nav.output.vel = v_e;
    

k = k + 1;

